{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Bash(bun *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(crontab *)",
      "Bash(launchctl *)",
      "Bash(nc *)",
      "Bash(op *)",
      "Bash(osascript *)",
      "Bash(rsync *)",
      "Bash(scp *)",
      "Bash(security *)",
      "Bash(sftp *)",
      "Bash(ssh *)",
      "Bash(sudo *)",
      "Read(./**/.env)",
      "Read(./**/.npmrc)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/credentials.json)",
      "Read(./**/id_ed25519*)",
      "Read(./**/id_rsa*)",
      "Read(./**/secrets/**)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(gh *)",
      "Bash(pn dlx *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpx *)",
      "Bash(pnx *)",
      "Edit(./.claude/settings.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "gh *",
      "git commit *",
      "git fetch *",
      "git pull *",
      "git push *",
      "git tag *"
    ],
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "allowLocalBinding": true
    }
  }
}
