{
  "name": "@monospaced/set-config",
  "version": "0.20.2",
  "description": "Shared developer-tooling config for Set. ESLint, Stylelint, Prettier, browserslist presets plus the --set-* token catalog for editor autocomplete and tooling.",
  "repository": {
    "type": "git",
    "url": "https://github.com/monospaced/set.git",
    "directory": "packages/config"
  },
  "type": "module",
  "files": [
    "baseline",
    "browserslist",
    "eslint",
    "stylelint",
    "set.catalog.css",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify.mjs"
  },
  "types": "./browserslist/index.d.ts",
  "exports": {
    "./baseline": {
      "types": "./baseline/index.d.ts",
      "default": "./baseline/index.mjs"
    },
    "./browserslist": {
      "types": "./browserslist/index.d.ts",
      "default": "./browserslist/index.mjs"
    },
    "./browserslist/esbuild": {
      "types": "./browserslist/esbuild.d.ts",
      "default": "./browserslist/esbuild.mjs"
    },
    "./browserslist/lightningcss": {
      "types": "./browserslist/lightningcss.d.ts",
      "default": "./browserslist/lightningcss.mjs"
    },
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.mjs"
    },
    "./eslint/app": {
      "types": "./eslint/app.d.ts",
      "default": "./eslint/app.mjs"
    },
    "./eslint/react": {
      "types": "./eslint/react.d.ts",
      "default": "./eslint/react.mjs"
    },
    "./stylelint": {
      "types": "./stylelint/index.d.ts",
      "default": "./stylelint/index.mjs"
    }
  },
  "browserslist": [
    "baseline widely available"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "eslint-plugin-baseline-js": "^0.7.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-order": "^8.1.1",
    "stylelint-plugin-logical-css": "^2.1.0",
    "stylelint-plugin-use-baseline": "^1.4.8",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "browserslist": "^4.0.0",
    "eslint": "^10.0.0",
    "lightningcss": "^1.0.0",
    "stylelint": "^17.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "browserslist": {
      "optional": true
    },
    "lightningcss": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "browserslist": "^4.29.5",
    "eslint": "catalog:",
    "lightningcss": "^1.33.0",
    "typescript": "catalog:"
  }
}
