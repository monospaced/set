{
  "name": "@monospaced/set-core",
  "version": "0.0.0",
  "description": "SSR-first component library for Set. Native HTML output via custom elements, with a co-located CSS contract.",
  "repository": {
    "type": "git",
    "url": "https://github.com/monospaced/set.git",
    "directory": "packages/core"
  },
  "type": "module",
  "style": "./dist/core.css",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/core.css"
  },
  "scripts": {
    "build": "vite build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide": "1.16.0"
  },
  "devDependencies": {
    "@monospaced/set-config": "workspace:*",
    "@monospaced/set-markdown": "workspace:*",
    "@monospaced/set-system": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "autoprefixer": "^10.5.0",
    "jsdom": "catalog:",
    "postcss": "^8.5.14",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
