{
  "name": "@monospaced/set-react-native",
  "version": "0.19.1",
  "description": "React Native components for Set. A sibling to the web library that shares Set's tokens and adapts the system to native paradigms.",
  "repository": {
    "type": "git",
    "url": "https://github.com/monospaced/set.git",
    "directory": "packages/react-native"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monospaced/set-tokens": "workspace:*"
  },
  "devDependencies": {
    "@monospaced/set-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "^0.87.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": ">=0.79.0",
    "react-native-svg": ">=15.0.0"
  }
}
