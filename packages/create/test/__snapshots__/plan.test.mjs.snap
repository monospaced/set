  "src/site.ts": "export const site = {
  name: "My Site",
  description: "My Site, built with Set.",
  // Set once the site has a domain; canonical and og:url derive from it.
  url: "https://example.com",
  ogImage: "https://res.cloudinary.com/monospaced/image/upload/v1789307953/2018-04-20_15.28.26--cyan--og--mid.png",
