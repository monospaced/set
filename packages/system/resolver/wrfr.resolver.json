{
  "$schema": "../schemas/2025.10/schema/resolver.json",
  "name": "WRFR resolver",
  "version": "2025.10",
  "description": "Resolver contexts for wrfr tokens (theme, surface, size, forced-colors).",
  "$defs": {
    "build": {
      "brand": "wrfr",
      "namespace": "set",
      "shared": {
        "mediaRef": "./shared/media.json#/size"
      },
      "tokenLayers": {
        "private": ["primitive"],
        "public": ["semantic"]
      },
      "targets": {
        "css": {
          "layer": "set.brand",
          "layerOrder": ["set", "set.brand"],
          "selectors": {
            "root": ":where(.{namespace}[data-set-brand=\"{brand}\"], .{namespace}[data-set-brand=\"{brand}\"] [data-set-surface=\"default\"])",
            "surfaceBrandSubtle": ":where(.{namespace}[data-set-brand=\"{brand}\"] [data-set-surface=\"brandSubtle\"])",
            "surfaceBrand": ":where(.{namespace}[data-set-brand=\"{brand}\"] [data-set-surface=\"brand\"])",
            "surfaceBrandSecondary": ":where(.{namespace}[data-set-brand=\"{brand}\"] [data-set-surface=\"brandSecondary\"])",
            "surfaceBrandTertiary": ":where(.{namespace}[data-set-brand=\"{brand}\"] [data-set-surface=\"brandTertiary\"])",
            "themeDark": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"dark\"], .{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"dark\"] [data-set-surface=\"default\"])",
            "themeLight": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"light\"], .{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"light\"] [data-set-surface=\"default\"])",
            "themeDarkSurfaceBrandSubtle": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"dark\"] [data-set-surface=\"brandSubtle\"])",
            "themeLightSurfaceBrandSubtle": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"light\"] [data-set-surface=\"brandSubtle\"])",
            "themeDarkSurfaceBrand": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"dark\"] [data-set-surface=\"brand\"])",
            "themeLightSurfaceBrand": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"light\"] [data-set-surface=\"brand\"])",
            "themeDarkSurfaceBrandSecondary": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"dark\"] [data-set-surface=\"brandSecondary\"])",
            "themeLightSurfaceBrandSecondary": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"light\"] [data-set-surface=\"brandSecondary\"])",
            "themeDarkSurfaceBrandTertiary": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"dark\"] [data-set-surface=\"brandTertiary\"])",
            "themeLightSurfaceBrandTertiary": ":where(.{namespace}[data-set-brand=\"{brand}\"][data-set-theme=\"light\"] [data-set-surface=\"brandTertiary\"])",
            "contentThemeLightSurfaceDefault": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"light\"][data-set-surface=\"default\"]",
            "contentThemeDarkSurfaceDefault": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"dark\"][data-set-surface=\"default\"]",
            "contentThemeLightSurfaceBrandSubtle": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"light\"][data-set-surface=\"brandSubtle\"]",
            "contentThemeDarkSurfaceBrandSubtle": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"dark\"][data-set-surface=\"brandSubtle\"]",
            "contentThemeLightSurfaceBrand": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"light\"][data-set-surface=\"brand\"]",
            "contentThemeDarkSurfaceBrand": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"dark\"][data-set-surface=\"brand\"]",
            "contentThemeLightSurfaceBrandSecondary": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"light\"][data-set-surface=\"brandSecondary\"]",
            "contentThemeDarkSurfaceBrandSecondary": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"dark\"][data-set-surface=\"brandSecondary\"]",
            "contentThemeLightSurfaceBrandTertiary": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"light\"][data-set-surface=\"brandTertiary\"]",
            "contentThemeDarkSurfaceBrandTertiary": ":where(.{namespace}[data-set-brand=\"{brand}\"]) [data-set-content-theme=\"dark\"][data-set-surface=\"brandTertiary\"]"
          },
          "modifiers": {
            "size": {
              "contexts": {
                "baseline": {},
                "tablet": {
                  "baseContext": "baseline",
                  "media": [
                    {
                      "mediaRef": "tablet"
                    }
                  ]
                },
                "notebook": {
                  "baseContext": "tablet",
                  "media": [
                    {
                      "mediaRef": "notebook"
                    }
                  ]
                },
                "laptop": {
                  "baseContext": "notebook",
                  "media": [
                    {
                      "mediaRef": "laptop"
                    }
                  ]
                },
                "desktop": {
                  "baseContext": "laptop",
                  "media": [
                    {
                      "mediaRef": "desktop"
                    }
                  ]
                }
              }
            },
            "theme": {
              "contexts": {
                "lightDefault": {
                  "selectorRef": "root",
                  "variants": [
                    {
                      "name": "forcedLight",
                      "deltaFromContext": "darkDefault",
                      "media": ["(prefers-color-scheme: dark)"],
                      "selectorRef": "themeLight"
                    }
                  ]
                },
                "lightBrandSubtle": {
                  "baseContext": "lightDefault",
                  "selectorRef": "surfaceBrandSubtle",
                  "variants": [
                    {
                      "name": "forcedLight",
                      "deltaFromContext": "darkBrandSubtle",
                      "media": ["(prefers-color-scheme: dark)"],
                      "selectorRef": "themeLightSurfaceBrandSubtle"
                    }
                  ]
                },
                "lightBrand": {
                  "baseContext": "lightDefault",
                  "selectorRef": "surfaceBrand",
                  "variants": [
                    {
                      "name": "forcedLight",
                      "deltaFromContext": "darkBrand",
                      "media": ["(prefers-color-scheme: dark)"],
                      "selectorRef": "themeLightSurfaceBrand"
                    }
                  ]
                },
                "lightBrandSecondary": {
                  "baseContext": "lightBrand",
                  "selectorRef": "surfaceBrandSecondary",
                  "variants": [
                    {
                      "name": "forcedLight",
                      "deltaFromContext": "darkBrandSecondary",
                      "media": ["(prefers-color-scheme: dark)"],
                      "selectorRef": "themeLightSurfaceBrandSecondary"
                    }
                  ]
                },
                "lightBrandTertiary": {
                  "baseContext": "lightBrand",
                  "selectorRef": "surfaceBrandTertiary",
                  "variants": [
                    {
                      "name": "forcedLight",
                      "deltaFromContext": "darkBrandTertiary",
                      "media": ["(prefers-color-scheme: dark)"],
                      "selectorRef": "themeLightSurfaceBrandTertiary"
                    }
                  ]
                },
                "darkDefault": {
                  "selectorRef": "root",
                  "baseContext": "lightDefault",
                  "media": ["(prefers-color-scheme: dark)"],
                  "variants": [
                    {
                      "name": "forcedDark",
                      "deltaFromContext": "lightDefault",
                      "selectorRef": "themeDark"
                    }
                  ]
                },
                "darkBrandSubtle": {
                  "baseContext": "darkDefault",
                  "selectorRef": "surfaceBrandSubtle",
                  "media": ["(prefers-color-scheme: dark)"],
                  "variants": [
                    {
                      "name": "forcedDark",
                      "deltaFromContext": "lightBrandSubtle",
                      "selectorRef": "themeDarkSurfaceBrandSubtle"
                    }
                  ]
                },
                "darkBrand": {
                  "baseContext": "darkDefault",
                  "selectorRef": "surfaceBrand",
                  "media": ["(prefers-color-scheme: dark)"],
                  "variants": [
                    {
                      "name": "forcedDark",
                      "deltaFromContext": "lightBrand",
                      "selectorRef": "themeDarkSurfaceBrand"
                    }
                  ]
                },
                "darkBrandSecondary": {
                  "baseContext": "darkBrand",
                  "selectorRef": "surfaceBrandSecondary",
                  "media": ["(prefers-color-scheme: dark)"],
                  "variants": [
                    {
                      "name": "forcedDark",
                      "deltaFromContext": "lightBrandSecondary",
                      "selectorRef": "themeDarkSurfaceBrandSecondary"
                    }
                  ]
                },
                "darkBrandTertiary": {
                  "baseContext": "darkBrand",
                  "selectorRef": "surfaceBrandTertiary",
                  "media": ["(prefers-color-scheme: dark)"],
                  "variants": [
                    {
                      "name": "forcedDark",
                      "deltaFromContext": "lightBrandTertiary",
                      "selectorRef": "themeDarkSurfaceBrandTertiary"
                    }
                  ]
                },
                "contentLightDefault": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeLightSurfaceDefault"
                },
                "contentDarkDefault": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeDarkSurfaceDefault"
                },
                "contentLightBrandSubtle": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeLightSurfaceBrandSubtle"
                },
                "contentDarkBrandSubtle": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeDarkSurfaceBrandSubtle"
                },
                "contentLightBrand": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeLightSurfaceBrand"
                },
                "contentDarkBrand": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeDarkSurfaceBrand"
                },
                "contentLightBrandSecondary": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeLightSurfaceBrandSecondary"
                },
                "contentDarkBrandSecondary": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeDarkSurfaceBrandSecondary"
                },
                "contentLightBrandTertiary": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeLightSurfaceBrandTertiary"
                },
                "contentDarkBrandTertiary": {
                  "baseContext": "lightDefault",
                  "selectorRef": "contentThemeDarkSurfaceBrandTertiary"
                }
              }
            },
            "forcedColors": {
              "contexts": {
                "on": {
                  "media": ["(forced-colors: active)"]
                }
              },
              "scope": {
                "size": ["baseline"],
                "theme": [
                  "lightDefault",
                  "lightBrandSubtle",
                  "lightBrand",
                  "lightBrandSecondary",
                  "lightBrandTertiary"
                ]
              }
            }
          }
        }
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/modifiers/size"
    },
    {
      "$ref": "#/modifiers/theme"
    },
    {
      "$ref": "#/modifiers/forcedColors"
    }
  ],
  "sets": {
    "base": {
      "description": "WRFR non-context token sources.",
      "sources": [
        {
          "$ref": "../src/base/primitive/spacing.tokens.json"
        },
        {
          "$ref": "../src/wrfr/primitive/color.tokens.json"
        },
        {
          "$ref": "../src/wrfr/primitive/effect.tokens.json"
        },
        {
          "$ref": "../src/wrfr/primitive/motion.tokens.json"
        },
        {
          "$ref": "../src/wrfr/primitive/radius.tokens.json"
        },
        {
          "$ref": "../src/wrfr/primitive/shape.tokens.json"
        },
        {
          "$ref": "../src/wrfr/primitive/typography.tokens.json"
        },
        {
          "$ref": "../src/wrfr/semantic/motion/tokens.json"
        },
        {
          "$ref": "../src/wrfr/semantic/layout/tokens.json"
        },
        {
          "$ref": "../src/wrfr/semantic/radius/tokens.json"
        },
        {
          "$ref": "../src/wrfr/semantic/shape/tokens.json"
        },
        {
          "$ref": "../src/wrfr/semantic/typography/tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "size": {
      "description": "Responsive size contexts.",
      "default": "baseline",
      "contexts": {
        "baseline": [
          {
            "$ref": "#/sets/base"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/baseline.tokens.json"
          }
        ],
        "tablet": [
          {
            "$ref": "#/sets/base"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/baseline.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/tablet.tokens.json"
          }
        ],
        "notebook": [
          {
            "$ref": "#/sets/base"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/baseline.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/tablet.tokens.json"
          }
        ],
        "laptop": [
          {
            "$ref": "#/sets/base"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/baseline.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/tablet.tokens.json"
          }
        ],
        "desktop": [
          {
            "$ref": "#/sets/base"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/baseline.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/tablet.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/typography/size/desktop.tokens.json"
          }
        ]
      }
    },
    "theme": {
      "description": "Theme and surface contexts, plus absolute content-theme overrides for poster-like content on non-themeable media.",
      "default": "lightDefault",
      "contexts": {
        "lightDefault": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/default.tokens.json"
          }
        ],
        "lightBrandSubtle": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/brandSubtle.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brandSubtle.tokens.json"
          }
        ],
        "lightBrand": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brand.tokens.json"
          }
        ],
        "lightBrandSecondary": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brandSecondary.tokens.json"
          }
        ],
        "lightBrandTertiary": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brandTertiary.tokens.json"
          }
        ],
        "contentLightDefault": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/default.tokens.json"
          }
        ],
        "contentLightBrandSubtle": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/brandSubtle.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brandSubtle.tokens.json"
          }
        ],
        "contentLightBrand": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brand.tokens.json"
          }
        ],
        "contentLightBrandSecondary": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brand.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brandSecondary.tokens.json"
          }
        ],
        "contentLightBrandTertiary": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brand.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/effect/theme/light/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/light/brandTertiary.tokens.json"
          }
        ],
        "darkDefault": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/default.tokens.json"
          }
        ],
        "darkBrandSubtle": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/brandSubtle.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brandSubtle.tokens.json"
          }
        ],
        "darkBrand": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brand.tokens.json"
          }
        ],
        "darkBrandSecondary": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brandSecondary.tokens.json"
          }
        ],
        "darkBrandTertiary": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brandTertiary.tokens.json"
          }
        ],
        "contentDarkDefault": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/default.tokens.json"
          }
        ],
        "contentDarkBrandSubtle": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/brandSubtle.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brandSubtle.tokens.json"
          }
        ],
        "contentDarkBrand": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brand.tokens.json"
          }
        ],
        "contentDarkBrandSecondary": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brand.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brandSecondary.tokens.json"
          }
        ],
        "contentDarkBrandTertiary": [
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brand.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/effect/theme/dark/default.tokens.json"
          },
          {
            "$ref": "../src/wrfr/semantic/color/theme/dark/brandTertiary.tokens.json"
          }
        ]
      }
    },
    "forcedColors": {
      "description": "forced-colors accessibility mode.",
      "default": "off",
      "contexts": {
        "off": [],
        "on": [
          {
            "$ref": "../src/wrfr/semantic/color/forced-colors/on.tokens.json"
          }
        ]
      }
    }
  }
}
