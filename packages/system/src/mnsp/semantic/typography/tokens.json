          "$description": "A single per-side sidebearing, in em.",
          "$type": "number",
          "$extensions": {
            "co.monospaced.set.css": {
              "unit": "em"
            }
          },
          "$value": "{primitive.typography.metric.mono.sideBearing.single}"
        },
        "pair": {
          "$description": "Both facing sidebearings combined — one inter-letter gap (2× single); basis for word-spacing, in em.",
          "$type": "number",
          "$extensions": {
            "co.monospaced.set.css": {
              "unit": "em"
            }
          },
          "$value": "{primitive.typography.metric.mono.sideBearing.pair}"
        }
      },
      "capBalance": {
        "$description": "Bottom padding to vertically balance a filled single-line cell (e.g. inline code), in em.",
        "$type": "number",
        "$extensions": {
          "co.monospaced.set.css": {
            "unit": "em"
          }
        },
        "$value": "{primitive.typography.metric.mono.capBalance}"
      }
    }
  },
  "measure": {
    "$type": "number",
    "tight": {
      "$description": "Tighter measure (line length, in em). A more constrained alternative to the default.",
      "$extensions": {
        "co.monospaced.set.css": {
          "unit": "em"
        }
      },
      "$value": "{primitive.typography.measure.sm}"
    },
    "default": {
      "$description": "Default measure (line length, in em). Use as the comfortable maximum width to keep line lengths readable.",
      "$extensions": {
        "co.monospaced.set.css": {
          "unit": "em"
        }
      },
      "$value": "{primitive.typography.measure.default}"
