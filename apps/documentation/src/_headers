# Netlify _headers file (passed through to the publish root by Eleventy).
# CSP allows 'unsafe-inline' for scripts and styles because the page ships
# an inline module bootstrap and Set emits inline style attributes; tighten
# with hashes/nonces later.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: https://res.cloudinary.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'

# Unhashed shared assets change between deploys — revalidate.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

# Subset font files are content-stable — safe to cache long.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
