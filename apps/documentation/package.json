{
  "name": "@measured/set-documentation",
  "version": "0.4.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/measuredco/set.git",
    "directory": "apps/documentation"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--import tsx\" eleventy --serve",
    "build": "pnpm --workspace-root run documentation:prepare && pnpm run build:eleventy",
    "build:eleventy": "NODE_OPTIONS=\"--import tsx\" eleventy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@measured/set-assets": "workspace:*",
    "@measured/set-core": "workspace:*",
    "@measured/set-markdown": "workspace:*",
    "@measured/set-skills": "workspace:*",
    "@measured/set-tokens": "workspace:*"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@types/node": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
